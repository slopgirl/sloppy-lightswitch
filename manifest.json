{
  "manifest_version": 2,
  "name": "Sloppy Lightswitch",
  "version": "0.2.0",
  "description": "Sloppily flip prefers-color-scheme per site or globally: the Sec-CH-Prefers-Color-Scheme client hint header AND what the page itself sees (matchMedia, CSS media queries). Modes: system, light, dark, invert.",
  "homepage_url": "https://macroslop.dev/sloppy-lightswitch",
  "browser_specific_settings": {
    "gecko": {
      "id": "sloppy-lightswitch@macroslop.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Sloppy Lightswitch",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
